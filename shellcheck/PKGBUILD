pkgname=shellcheck
pkgver=0.11.0
pkgrel=1
pkgdesc="Static analysis tool for shell scripts (prebuilt upstream binary)"
arch=(x86_64)
url="https://www.shellcheck.net"
license=(GPL-3.0-or-later)
conflicts=(shellcheck-bin)
replaces=(shellcheck-bin)
options=(!strip !debug)
source_x86_64=("https://github.com/koalaman/shellcheck/releases/download/v${pkgver}/shellcheck-v${pkgver}.linux.x86_64.tar.xz")
sha256sums_x86_64=('8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198')

package() {
  install -Dm755 "$srcdir/shellcheck-v${pkgver}/shellcheck" "$pkgdir/usr/bin/shellcheck"
}
