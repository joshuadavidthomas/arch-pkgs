# Maintainer: Josh Thomas <josh@joshthomas.dev>

pkgname=paper-design
pkgver=0.5.6
pkgrel=1
pkgdesc="A collaborative design tool built on web standards with agent integration"
arch=(x86_64)
url="https://paper.design"
license=(LicenseRef-proprietary)
depends=(
  gtk3
  libnotify
  nss
  libxss
  libxtst
  xdg-utils
  at-spi2-core
  util-linux-libs
  libsecret
)
optdepends=(
  'libappindicator-gtk3: system tray support'
)
provides=(paper-desktop)
options=(!strip !debug)
source=("paper-design-${pkgver}.deb::https://download.paper.design/linux/deb"
        "paper-design-LICENSE-${pkgver}::https://paper.design/legal/tos")
sha256sums=('2855f30338c7d19ee53c1839d3b35040f0a5061f7120c6323abea07f241ef729'
            '2c6f14a856bee5b5f8f593c2821c69109ef5bf61d31758e9fc11a888e54ec299')

prepare() {
  local control=("$srcdir"/control.tar.*)
  local upstream_version
  upstream_version=$(bsdtar -xOf "${control[0]}" ./control |
    sed -n 's/^Version: //p')
  if [[ "$upstream_version" != "$pkgver"-* ]]; then
    echo "Downloaded Paper ${upstream_version:-<unknown>}, expected $pkgver" >&2
    return 1
  fi
}

package() {
  cd "$srcdir"

  bsdtar -xf data.tar.* -C "$pkgdir/"
  install -Dm644 "$srcdir/paper-design-LICENSE-${pkgver}" \
    "$pkgdir/usr/share/licenses/$pkgname/TERMS.html"

  # fix permissions on chrome-sandbox
  chmod 4755 "$pkgdir/opt/Paper/chrome-sandbox"

  # symlink binary to /usr/bin
  install -d "$pkgdir/usr/bin"
  ln -s /opt/Paper/paper-desktop "$pkgdir/usr/bin/paper-desktop"
}
