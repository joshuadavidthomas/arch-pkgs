# Maintainer: Josh Thomas <josh@joshthomas.dev>

pkgname=opencode-desktop
pkgver=1.18.26
pkgrel=1
pkgdesc="OpenCode desktop client"
arch=(x86_64)
url="https://opencode.ai"
license=(MIT)
_electron=electron42
depends=(ripgrep "$_electron")
optdepends=('libappindicator-gtk3: tray icon support')
conflicts=(opencode-desktop-bin)
replaces=(opencode-desktop-bin)
options=(!strip !debug)
source=("opencode-desktop-LICENSE-${pkgver}::https://raw.githubusercontent.com/anomalyco/opencode/v${pkgver}/LICENSE")
source_x86_64=("opencode-desktop-${pkgver}-linux-amd64.deb::https://github.com/anomalyco/opencode/releases/download/v${pkgver}/opencode-desktop-linux-amd64.deb")
sha256sums=('625f0f619133f89bbbb2abe37369613dfa1885eba1e50d02170deb62bb42cb6b')
sha256sums_x86_64=('84cbf698f930fda3477cf108f4aa9801b4c4a4875fa048d9f60b3ac583a6e184')

package() {
  bsdtar -xf "$srcdir"/data.tar.* -C "$pkgdir"

  local bundled
  bundled=$(grep -aoP 'Electron/\K[0-9]+' "$pkgdir/opt/OpenCode/ai.opencode.desktop" | head -1)
  if [[ "electron${bundled}" != "$_electron" ]]; then
    echo "Upstream now bundles Electron ${bundled:-<undetected>}; set _electron=electron${bundled}" >&2
    exit 1
  fi

  local appdir="$pkgdir/usr/lib/opencode-desktop"
  install -d "$appdir"
  mv "$pkgdir/opt/OpenCode/resources/"* "$appdir/"
  rm -rf "$pkgdir/opt" "$pkgdir/usr/share/doc"
  rm -f "$appdir/apparmor-profile" "$appdir/app-update.yml"
  find "$appdir" -name '*.musl.node' -delete
  find "$appdir" -depth -type d -name '*-musl' -exec rm -rf {} +

  install -Dm755 /dev/stdin "$pkgdir/usr/bin/opencode-desktop" <<EOF
#!/bin/bash
XDG_CONFIG_HOME="\${XDG_CONFIG_HOME:-\$HOME/.config}"
if [[ -f "\$XDG_CONFIG_HOME/opencode-desktop-flags.conf" ]]; then
  OPENCODE_USER_FLAGS="\$(grep -v '^#' "\$XDG_CONFIG_HOME/opencode-desktop-flags.conf")"
fi
exec $_electron /usr/lib/opencode-desktop/app.asar \$OPENCODE_USER_FLAGS "\$@"
EOF

  sed -i 's|Exec=/opt/OpenCode/ai\.opencode\.desktop|Exec=opencode-desktop|' \
    "$pkgdir"/usr/share/applications/*.desktop
  install -Dm644 "$srcdir/opencode-desktop-LICENSE-${pkgver}" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
