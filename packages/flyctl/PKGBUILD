# Maintainer: Josh Thomas <josh@joshthomas.dev>

pkgname=flyctl
pkgver=0.5.6
pkgrel=1
pkgdesc="Command line tools for fly.io services"
arch=(x86_64)
url="https://fly.io"
license=(Apache-2.0)
conflicts=(flyctl-bin)
replaces=(flyctl-bin)
options=(!strip !debug)
source_x86_64=("flyctl_${pkgver}_Linux_x86_64.tar.gz::https://github.com/superfly/flyctl/releases/download/v${pkgver}/flyctl_${pkgver}_Linux_x86_64.tar.gz")
sha256sums_x86_64=('401457b0606fe67989519b8788ca9ca2c7701668b5e76d5cdc2ca0ab6cc87cb1')

package() {
  install -Dm755 "$srcdir/flyctl" "$pkgdir/usr/bin/flyctl"
  ln -s flyctl "$pkgdir/usr/bin/fly"
}
