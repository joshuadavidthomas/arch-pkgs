pkgbase = voxtype-vulkan
	pkgdesc = Push-to-talk voice-to-text for Linux (Vulkan GPU acceleration)
	pkgver = 1.0.1
	pkgrel = 1
	url = https://voxtype.io
	arch = x86_64
	license = MIT
	depends = alsa-lib
	depends = curl
	depends = gcc-libs
	depends = glibc
	depends = vulkan-icd-loader
	optdepends = wtype: keyboard simulation for Wayland (recommended, best CJK support)
	optdepends = dotool: keyboard simulation with layout support (KDE/GNOME compatible)
	optdepends = ydotool: keyboard simulation fallback (X11/TTY support)
	optdepends = wl-clipboard: clipboard support
	optdepends = libnotify: desktop notifications
	optdepends = pipewire: audio server (recommended)
	optdepends = pipewire-alsa: ALSA compatibility for PipeWire (required if using PipeWire)
	optdepends = pulseaudio: audio server (alternative to PipeWire)
	optdepends = ollama: local AI summarization for meeting mode
	optdepends = gtk4-layer-shell: runtime for the GTK4 on-screen mic visualizer
	optdepends = quickshell: Quickshell-based OSD frontend
	provides = voxtype
	conflicts = voxtype
	conflicts = voxtype-bin
	replaces = voxtype-bin
	options = !strip
	options = !debug
	backup = etc/voxtype/config.toml
	source = voxtype-1.0.1-vulkan::https://github.com/peteonrails/voxtype/releases/download/v1.0.1/voxtype-1.0.1-linux-x86_64-vulkan
	source = voxtype-1.0.1-osd::https://github.com/peteonrails/voxtype/releases/download/v1.0.1/voxtype-1.0.1-linux-x86_64-osd
	source = voxtype-1.0.1-osd-gtk4::https://github.com/peteonrails/voxtype/releases/download/v1.0.1/voxtype-1.0.1-linux-x86_64-osd-gtk4
	source = voxtype-1.0.1-osd-quickshell::https://github.com/peteonrails/voxtype/releases/download/v1.0.1/voxtype-1.0.1-linux-x86_64-osd-quickshell
	source = voxtype-1.0.1-audio-bridge::https://github.com/peteonrails/voxtype/releases/download/v1.0.1/voxtype-1.0.1-linux-x86_64-audio-bridge
