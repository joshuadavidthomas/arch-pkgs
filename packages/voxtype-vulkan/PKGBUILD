# Maintainer: Josh Thomas <josh@joshthomas.dev>

pkgname=voxtype-vulkan
pkgver=1.0.0
pkgrel=1
pkgdesc="Push-to-talk voice-to-text for Linux (Vulkan GPU acceleration)"
arch=(x86_64)
url="https://voxtype.io"
license=(MIT)
depends=(alsa-lib curl gcc-libs glibc vulkan-icd-loader)
optdepends=('wtype: keyboard simulation for Wayland (recommended, best CJK support)'
            'dotool: keyboard simulation with layout support (KDE/GNOME compatible)'
            'ydotool: keyboard simulation fallback (X11/TTY support)'
            'wl-clipboard: clipboard support'
            'libnotify: desktop notifications'
            'pipewire: audio server (recommended)'
            'pipewire-alsa: ALSA compatibility for PipeWire (required if using PipeWire)'
            'pulseaudio: audio server (alternative to PipeWire)'
            'ollama: local AI summarization for meeting mode'
            'gtk4-layer-shell: runtime for the GTK4 on-screen mic visualizer'
            'quickshell: Quickshell-based OSD frontend')
provides=(voxtype)
conflicts=(voxtype voxtype-bin)
replaces=(voxtype-bin)
backup=(etc/voxtype/config.toml)
options=(!strip !debug)
_github="https://github.com/peteonrails/voxtype/releases/download/v$pkgver"
_raw="https://raw.githubusercontent.com/peteonrails/voxtype/v$pkgver"
source=("voxtype-$pkgver-vulkan::$_github/voxtype-$pkgver-linux-x86_64-vulkan"
        "voxtype-$pkgver-osd::$_github/voxtype-$pkgver-linux-x86_64-osd"
        "voxtype-$pkgver-osd-gtk4::$_github/voxtype-$pkgver-linux-x86_64-osd-gtk4"
        "voxtype-$pkgver-osd-quickshell::$_github/voxtype-$pkgver-linux-x86_64-osd-quickshell"
        "voxtype-$pkgver-audio-bridge::$_github/voxtype-$pkgver-linux-x86_64-audio-bridge"
        "config-$pkgver.toml::$_raw/config/default.toml"
        "voxtype-$pkgver.service::$_raw/packaging/systemd/voxtype.service"
        "voxtype-$pkgver.bash::$_raw/packaging/completions/voxtype.bash"
        "voxtype-$pkgver.zsh::$_raw/packaging/completions/voxtype.zsh"
        "voxtype-$pkgver.fish::$_raw/packaging/completions/voxtype.fish"
        "voxtype-LICENSE-$pkgver::$_raw/LICENSE"
        "README-$pkgver.md::$_raw/README.md"
        "voxtype-configure-$pkgver.desktop::$_raw/packaging/voxtype-configure.desktop"
        "voxtype-configure-launcher-$pkgver::$_raw/packaging/scripts/voxtype-configure-launcher"
        "quickshell-shell-$pkgver.qml::$_raw/quickshell/shell.qml"
        "quickshell-OsdSurface-$pkgver.qml::$_raw/quickshell/OsdSurface.qml"
        "quickshell-EnginePicker-$pkgver.qml::$_raw/quickshell/EnginePicker.qml"
        "quickshell-MeetingControls-$pkgver.qml::$_raw/quickshell/MeetingControls.qml"
        "quickshell-voxtype-shared-Theme-$pkgver.qml::$_raw/quickshell/voxtype-shared/Theme.qml"
        "quickshell-voxtype-shared-StateReader-$pkgver.qml::$_raw/quickshell/voxtype-shared/StateReader.qml"
        "quickshell-voxtype-shared-AudioBridge-$pkgver.qml::$_raw/quickshell/voxtype-shared/AudioBridge.qml"
        "quickshell-voxtype-shared-qmldir-$pkgver::$_raw/quickshell/voxtype-shared/qmldir")
