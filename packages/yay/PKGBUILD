# Maintainer: Josh Thomas <josh@joshthomas.dev>

pkgname=yay
pkgver=13.0.1
pkgrel=1
pkgdesc="Pacman wrapper and AUR helper written in Go"
arch=(x86_64)
url="https://github.com/Jguer/yay"
license=(GPL-3.0-or-later)
depends=('pacman>6.1' git)
optdepends=('sudo: privilege elevation'
            'doas: privilege elevation')
conflicts=(yay-bin)
replaces=(yay-bin)
options=(!strip !debug)
source_x86_64=("yay_${pkgver}_x86_64.tar.gz::https://github.com/Jguer/yay/releases/download/v${pkgver}/yay_${pkgver}_x86_64.tar.gz")
sha256sums_x86_64=('1fdfcb5f7f387bc858d3a5754bdf4e4575bfbddac9560535a716d0ed7189c057')

package() {
  local output="$srcdir/yay_${pkgver}_x86_64"
  install -Dm755 "$output/yay" -t "$pkgdir/usr/bin"
  install -Dm644 "$output/yay.8" "$pkgdir/usr/share/man/man8/yay.8"
  install -Dm644 "$output/bash" "$pkgdir/usr/share/bash-completion/completions/yay"
  install -Dm644 "$output/zsh" "$pkgdir/usr/share/zsh/site-functions/_yay"
  install -Dm644 "$output/fish" "$pkgdir/usr/share/fish/vendor_completions.d/yay.fish"

  local lang
  for lang in ca cs de en es eu fr_FR he id it_IT ja ko pl_PL pt_BR pt ru_RU ru sv tr uk zh_CN zh_TW; do
    install -Dm644 "$output/$lang.mo" "$pkgdir/usr/share/locale/$lang/LC_MESSAGES/yay.mo"
  done
}
