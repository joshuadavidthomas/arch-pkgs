# Maintainer: Josh Thomas <josh@joshthomas.dev>

pkgname=crush
pkgver=0.96.1
pkgrel=1
pkgdesc="Glamourous AI coding agent for your favourite terminal"
arch=(x86_64)
url="https://github.com/charmbracelet/crush"
license=(FSL-1.1-MIT)
conflicts=(crush-bin)
replaces=(crush-bin)
options=(!strip !debug)
source_x86_64=("crush_${pkgver}_Linux_x86_64.tar.gz::https://github.com/charmbracelet/crush/releases/download/v${pkgver}/crush_${pkgver}_Linux_x86_64.tar.gz")
sha256sums_x86_64=('5411b0906a82162dcab4a99071d70accf1caad0eee69789416dd607943c6680d')

package() {
  cd "$srcdir/crush_${pkgver}_Linux_x86_64"
  install -Dm755 crush "$pkgdir/usr/bin/crush"
  install -Dm644 completions/crush.bash "$pkgdir/usr/share/bash-completion/completions/crush"
  install -Dm644 completions/crush.zsh "$pkgdir/usr/share/zsh/site-functions/_crush"
  install -Dm644 completions/crush.fish "$pkgdir/usr/share/fish/vendor_completions.d/crush.fish"
  install -Dm644 manpages/crush.1.gz "$pkgdir/usr/share/man/man1/crush.1.gz"
  install -Dm644 LICENSE.md "$pkgdir/usr/share/licenses/crush/LICENSE.md"
}
