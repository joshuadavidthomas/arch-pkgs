# Maintainer: Josh Thomas <josh@joshthomas.dev>

pkgname=visual-studio-code
pkgver=1.135.0
pkgrel=1
pkgdesc="Visual Studio Code: editor for building and debugging modern web and cloud applications"
arch=(x86_64)
url="https://code.visualstudio.com"
license=('LicenseRef-Microsoft-VS-Code')
depends=(alsa-lib gcc-libs glibc gnupg gtk3 libnotify libsecret libxkbfile libxss
         lsof nss shared-mime-info xdg-utils)
optdepends=('glib2: Needed for move to trash functionality'
            'libdbusmenu-glib: Needed for KDE global menu'
            'org.freedesktop.secrets: Needed for settings sync')
provides=(code vscode)
conflicts=(code visual-studio-code-bin)
replaces=(visual-studio-code-bin)
options=(!strip !debug)
source=('visual-studio-code.sh')
source_x86_64=("code_${pkgver}_amd64.deb::https://update.code.visualstudio.com/${pkgver}/linux-deb-x64/stable")
sha256sums=('c0cf4b0842cacd54b09c401999273f24197cf8879130a23343e98cec6207d98e')
sha256sums_x86_64=('e8101720f0a48f8e6ae5a4112d10ffea5f13d298e7d0a7012b4e36eebc53022c')

package() {
  bsdtar -xf "$srcdir"/data.tar.* -C "$pkgdir"
  install -d "$pkgdir/usr/share/licenses/$pkgname"
  ln -s /usr/share/code/resources/app/LICENSE.rtf \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.rtf"
  install -Dm755 "$srcdir/visual-studio-code.sh" "$pkgdir/usr/bin/code"
  sed -i 's/^\(Exec=\)[^ ]*/\1code/g' "$pkgdir"/usr/share/applications/*.desktop
  chmod u-s "$pkgdir/usr/share/code/chrome-sandbox"
}
