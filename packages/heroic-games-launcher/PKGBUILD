# Maintainer: Josh Thomas <josh@joshthomas.dev>

pkgname=heroic-games-launcher
pkgver=2.22.3
pkgrel=1
pkgdesc="Native GOG, Amazon and Epic Games Launcher"
arch=(x86_64)
url="https://heroicgameslauncher.com"
license=(GPL-3.0-only)
depends=(gtk3 which)
conflicts=(heroic-games-launcher-bin)
replaces=(heroic-games-launcher-bin)
options=(!strip !debug)
noextract=("Heroic-${pkgver}-linux-x64.pacman")
source_x86_64=("https://github.com/Heroic-Games-Launcher/HeroicGamesLauncher/releases/download/v${pkgver}/Heroic-${pkgver}-linux-x64.pacman")
sha256sums_x86_64=('ed17ce083a71dd7e49a89218052ab475edd5a654cedf443853f6baacbb0a00e9')

package() {
  bsdtar -xf "$srcdir/Heroic-${pkgver}-linux-x64.pacman" -C "$pkgdir" usr opt
  mkdir -p "$pkgdir/usr/bin"
  ln -s /opt/Heroic/heroic "$pkgdir/usr/bin/heroic"
}
