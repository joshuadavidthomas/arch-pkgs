# Maintainer: Josh Thomas <josh@joshthomas.dev>

pkgname=pandoc
pkgver=3.12.1
pkgrel=1
pkgdesc="Universal markup converter (prebuilt upstream binary)"
arch=(x86_64)
url="https://pandoc.org"
license=(GPL-2.0-or-later)
provides=(pandoc-cli)
conflicts=(pandoc-cli pandoc-bin)
replaces=(pandoc-bin)
options=(!strip !debug)
source_x86_64=("https://github.com/jgm/pandoc/releases/download/${pkgver}/pandoc-${pkgver}-linux-amd64.tar.gz")
sha256sums_x86_64=('d0c90410e90204c9ca83b8539fac5c7aed01fd537207e4585849f8abc5df20b8')

package() {
  cd "$srcdir/pandoc-$pkgver"
  install -Dm755 bin/pandoc "$pkgdir/usr/bin/pandoc"
  ln -s pandoc "$pkgdir/usr/bin/pandoc-lua"
  ln -s pandoc "$pkgdir/usr/bin/pandoc-server"
  install -Dm644 share/man/man1/pandoc.1.gz "$pkgdir/usr/share/man/man1/pandoc.1.gz"
  install -Dm644 share/man/man1/pandoc-lua.1.gz "$pkgdir/usr/share/man/man1/pandoc-lua.1.gz"
  install -Dm644 share/man/man1/pandoc-server.1.gz "$pkgdir/usr/share/man/man1/pandoc-server.1.gz"
}
