# Maintainer: czyt <czytcn@gmail.com>
# Maintainer: Josh Thomas <josh@joshthomas.dev>

pkgname=codiff-bin
pkgver=1.9.0
pkgrel=5
pkgdesc="A beautiful, minimal, local diff viewer for reviewing staged and unstaged Git changes before committing"
arch=(x86_64)
url="https://codiff.dev"
license=(MIT)
depends=(
  gtk3
  nss
  at-spi2-core
  alsa-lib
  cups
  mesa
  libxcomposite
  libxdamage
  libxkbcommon
  libxrandr
)
provides=(codiff)
conflicts=(codiff)
options=(!strip !debug)
source_x86_64=("codiff_${pkgver}_amd64.deb::https://github.com/nkzw-tech/codiff/releases/download/v${pkgver}/codiff_${pkgver}_amd64.deb")
sha256sums_x86_64=('00758e6bf8d188eb8bff4a0ef4dc324ec936854e4be7408b7d1494f70ccce830')

package() {
  cd "$srcdir"

  bsdtar -xf data.tar.* -C "$pkgdir/"

  # fix permissions on chrome-sandbox
  chmod 4755 "$pkgdir/usr/lib/codiff/chrome-sandbox"

  # remove Debian-only packaging metadata
  rm -rf "$pkgdir/usr/share/lintian" "$pkgdir/usr/share/doc"

  # pahole owns /usr/bin/codiff, so install the app under a distinct name.
  # Recover the graphical environment for long-lived terminal sessions, then
  # explicitly select Wayland because Electron's auto detection sees a TTY.
  rm -f "$pkgdir/usr/bin/codiff"
  cat > "$pkgdir/usr/bin/codiff-app" <<'EOF'
#!/bin/sh
if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -z "${DISPLAY:-}" ]; then
  user_environment=$(systemctl --user show-environment 2>/dev/null || true)
  XDG_RUNTIME_DIR=$(printf '%s\n' "$user_environment" | sed -n 's/^XDG_RUNTIME_DIR=//p')
  WAYLAND_DISPLAY=$(printf '%s\n' "$user_environment" | sed -n 's/^WAYLAND_DISPLAY=//p')
  DISPLAY=$(printf '%s\n' "$user_environment" | sed -n 's/^DISPLAY=//p')
  export XDG_RUNTIME_DIR WAYLAND_DISPLAY DISPLAY
fi

if [ -n "${WAYLAND_DISPLAY:-}" ]; then
  set -- --ozone-platform=wayland "$@"
fi

exec /usr/lib/codiff/codiff "$@"
EOF
  chmod 755 "$pkgdir/usr/bin/codiff-app"
  sed -i 's/^Exec=codiff /Exec=codiff-app /' "$pkgdir/usr/share/applications/codiff.desktop"
}
