# Maintainer: Josh Thomas <josh@joshthomas.dev>

pkgname=atuin-desktop
pkgver=0.2.20
pkgrel=1
pkgdesc="Runbooks that run: a local-first, executable runbook editor"
arch=(x86_64)
url="https://github.com/atuinsh/desktop"
license=(Apache-2.0)
depends=(cairo dbus fontconfig gcc-libs gdk-pixbuf2 glib2 glibc gtk3
         hicolor-icon-theme libsoup3 pango webkit2gtk-4.1 zlib)
conflicts=(atuin-desktop-bin)
replaces=(atuin-desktop-bin)
options=(!strip !debug)
source=("atuin-desktop-LICENSE-${pkgver}::https://raw.githubusercontent.com/atuinsh/desktop/v${pkgver}/LICENSE")
source_x86_64=("atuin-desktop-${pkgver}.rpm::https://github.com/atuinsh/desktop/releases/download/v${pkgver}/Atuin_Desktop-${pkgver}-1.x86_64.rpm")
noextract=("atuin-desktop-${pkgver}.rpm")
sha256sums=('SKIP')
sha256sums_x86_64=('SKIP')

package() {
  bsdtar -xf "$srcdir/atuin-desktop-${pkgver}.rpm" -C "$pkgdir"
  install -Dm644 "$srcdir/atuin-desktop-LICENSE-${pkgver}" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
