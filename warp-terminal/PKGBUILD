# Maintainer: Josh Thomas <josh@joshthomas.dev>

pkgname=warp-terminal
pkgver=0.2026.08.05.09.03.stable_01
pkgrel=1
pkgdesc="Intelligent terminal with AI and team knowledge built in"
arch=(x86_64)
url="https://warp.dev"
license=(LicenseRef-proprietary)
depends=(alsa-lib gtk3 libxcb libxkbcommon-x11 libxss nss)
conflicts=(warp-terminal-bin)
replaces=(warp-terminal-bin)
options=(!strip !debug)
source_x86_64=("warp-terminal-${pkgver}-x86_64.pkg.tar.zst::https://releases.warp.dev/stable/v${pkgver}/warp-terminal-v${pkgver}-1-x86_64.pkg.tar.zst")
noextract=("warp-terminal-${pkgver}-x86_64.pkg.tar.zst")
sha256sums_x86_64=('463f56d856e7cf739fce057838e988e2bcb20750cec8b06d0fa2f26791721a66')

package() {
  bsdtar -xf "$srcdir/warp-terminal-${pkgver}-x86_64.pkg.tar.zst" -C "$pkgdir"
  rm -f "$pkgdir"/{.BUILDINFO,.INSTALL,.MTREE,.PKGINFO}

  if [[ -f "$pkgdir/usr/bin/warp" && ! -e "$pkgdir/usr/bin/warp-terminal" ]]; then
    ln -s /usr/bin/warp "$pkgdir/usr/bin/warp-terminal"
  elif [[ -f "$pkgdir/opt/warp/warp" && ! -e "$pkgdir/usr/bin/warp-terminal" ]]; then
    install -dm755 "$pkgdir/usr/bin"
    ln -s /opt/warp/warp "$pkgdir/usr/bin/warp-terminal"
  fi
}
